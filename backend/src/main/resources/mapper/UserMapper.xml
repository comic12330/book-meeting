<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.meetingroom.mapper.UserMapper">

    <sql id="Base_Column_List">
        id, username, password, real_name, phone, role, status, create_time
    </sql>

    <select id="findByUsername" resultType="com.example.meetingroom.entity.User">
        SELECT
        <include refid="Base_Column_List"/>
        FROM `user`
        WHERE username = #{username}
        LIMIT 1
    </select>

    <select id="findById" resultType="com.example.meetingroom.entity.User">
        SELECT
        <include refid="Base_Column_List"/>
        FROM `user`
        WHERE id = #{id}
    </select>

    <select id="selectByCondition" parameterType="com.example.meetingroom.dto.UserQueryDTO"
            resultType="com.example.meetingroom.entity.User">
        SELECT
        <include refid="Base_Column_List"/>
        FROM `user`
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="realName != null and realName != ''">
                AND real_name LIKE CONCAT('%', #{realName}, '%')
            </if>
            <if test="role != null">
                AND role = #{role}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id ASC
    </select>

    <!--
        统计「除指定用户之外，还有几个启用的管理员」。
        返回 0 说明该用户是最后一名启用的管理员，此时不允许把它降级或停用，
        否则系统将没有任何人能进入管理端。
    -->
    <select id="countOtherActiveAdmin" resultType="int">
        SELECT COUNT(1)
        FROM `user`
        WHERE role = 1
          AND status = 1
        <if test="excludeId != null">
            AND id &lt;&gt; #{excludeId}
        </if>
    </select>

    <insert id="insert" parameterType="com.example.meetingroom.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (username, password, real_name, phone, role, status)
        VALUES (#{username}, #{password}, #{realName}, #{phone}, #{role}, #{status})
    </insert>

    <!--
        自助修改资料：SET 子句只有真实姓名与手机号两列。
        即使请求体里塞了 role 或 status，这里也不会写入，等于在 SQL 层再挡一次提权。
    -->
    <update id="updateProfile" parameterType="com.example.meetingroom.entity.User">
        UPDATE `user`
        SET real_name = #{realName},
            phone     = #{phone}
        WHERE id = #{id}
    </update>

    <!--
        管理端编辑账号：可改姓名、手机号、角色、状态。
        用户名与密码不在这里修改，改密走 updatePassword 这条独立语句。
    -->
    <update id="updateByAdmin" parameterType="com.example.meetingroom.entity.User">
        UPDATE `user`
        SET real_name = #{realName},
            phone     = #{phone},
            role      = #{role},
            status    = #{status}
        WHERE id = #{id}
    </update>

    <!-- 改密：调用方已把新密码加密，这里收到的就是最终入库的哈希值 -->
    <update id="updatePassword">
        UPDATE `user`
        SET password = #{password}
        WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE `user`
        SET status = #{status}
        WHERE id = #{id}
    </update>
</mapper>
